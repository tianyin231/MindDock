# MindDock 部署配置示例。install.sh 会自动生成真正的 .env，一般无需手动复制。
# 业务设置（QQ 机器人、AI 模型、夸克网盘、邮件通知）在面板的"设置"页填写，不放在这里。

MINDDOCK_DOMAIN=minddock.example.com
MINDDOCK_PUBLIC_URL=https://minddock.example.com:8443
# 镜像标签：main 跟随最新提交；也可以固定为某个版本，如 0.2.0
MINDDOCK_TAG=main
# 面板设置中密钥字段的加密主密钥：openssl rand -base64 32
MINDDOCK_SECRET_KEY=
# 内置 OpenList 的管理员密码：openssl rand -hex 16
MINDDOCK_OPENLIST_ADMIN_PASSWORD=
TZ=Asia/Shanghai
